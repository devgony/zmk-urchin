#include "keymap_italian.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Mouse max velocity (ZMK default 600). Must be defined before including
// pointing.h, which bakes it into the MOVE_* defines.
//
// With acceleration-exponent = 1 the speed curve is v(t) = VAL * t / time-to-max-speed-ms,
// so the two knobs are independent:
//   VAL / time-to-max-speed-ms  ->  how quickly the cursor picks up from a standstill
//   VAL                         ->  top speed (how hard fine positioning is)
// Sluggish start? lower time-to-max-speed-ms. Too fast? lower both by the same ratio.
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1100

// Scroll rate, in wheel detents per second. Scroll has NO acceleration ramp
// (&msc ships acceleration-exponent 0), so the only thing this controls is a flat rate,
// and first-detent latency is locked to it at 1000 / VAL ms:
//
//   VAL     first detent     sustained
//    10       112 ms          10 /s     <- ZMK default: taps under 112ms scroll nothing
//    20        64 ms          20 /s
//    30        48 ms          30 /s
//    40        32 ms          40 /s
//    63+       16 ms          62 /s     <- ceiling, one detent every 16ms tick
//
// Vertical gets its own higher rate. ZMK has no axis asymmetry - both axes share one
// rate - but the same detent rate feels far slower vertically because there is much
// more distance to cover.
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20  // horizontal, default 10

#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

#define VSCRL_UP   MOVE_Y(40)
#define VSCRL_DOWN MOVE_Y(-40)

// Layer definitions

#define BASE 0
#define SYM 1
#define EXT 2
#define FNC 3
#define SYM2 4
#define ACCENT 5
#define SETTINGS 6

// -----------------

&mt { flavor = "tap-preferred"; };

// Keyboard mouse (ESDF).
// acceleration-exponent must stay 1. The ramp is tracked per axis and restarts whenever
// that axis' net speed hits 0, so with exponent 2 a newly pressed direction is nearly
// frozen for its first ~50ms and 8-way/diagonal transitions visibly stutter.
&mmv {
    time-to-max-speed-ms = <150>;
    acceleration-exponent = <1>;
};

// Scroll stays at exponent 0 on purpose: constant rate from the very first detent, so
// reversing or switching axes never re-ramps. Speed is set by the SCRL values above.
//
// Note that with exponent 0 speed() early-returns max_speed, so time-to-max-speed-ms is
// never read for this behavior. Tuning it does nothing.
//
// Do NOT reach for CONFIG_ZMK_POINTING_SMOOTH_SCROLLING to fix scroll latency. At the
// pinned ZMK revision apply_resolution_scaling() assigns the unscaled value back to the
// event, and the default multiplier profile makes the divisor 1 anyway, so it changes
// nothing here - while being reported broken over BLE on macOS (zmk#2957).
&msc {
    acceleration-exponent = <0>;
};

// Precision mode: on the pointing layer, hold the left thumb key that types BACKSPACE
// on the base layer (position 30) to halve cursor and scroll speed. The other left thumb
// is left alone so LCMD is still available for cmd-click.
// The listener re-checks active layers on every input event, so this engages mid-move
// without resetting the acceleration ramp. The scalers track remainders, so halving
// does not drop sub-pixel movement.
// For scroll this lands back near ZMK's stock feel: vertical 40 -> 20/s, horizontal
// 20 -> 10/s. Note the scaler runs before resolution scaling, so it divides raw detents.
&mmv_input_listener {
    precision {
        layers = <6>;
        input-processors = <&zip_xy_scaler 1 2>;
    };
};

&msc_input_listener {
    precision {
        layers = <6>;
        input-processors = <&zip_scroll_scaler 1 2>;
    };
};

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        tap_vim_cc: tap_vim_cc {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_VIM_CC";
            #binding-cells = <0>;
            bindings = <&none>, <&vim_cc>;

            tapping-term-ms = <50>;
        };
    };

    macros {
        // sometimes my device thinks a modifier is being held down
        // pressing all modifiers fixes it.

        L_w: L_W {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp LALT>;

            label = "L_W";
        };

        D_x4: D_X4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOWN &kp DOWN &kp DOWN &kp DOWN>;
            label = "D_X4";
        };

        U_x4: U_X4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp UP_ARROW &kp UP_ARROW &kp UP_ARROW &kp UP_ARROW>;
            label = "U_X4";
        };

        R_w: R_W {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp LALT>;

            label = "R_W";
        };

        vim_cb: vim_cb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp BACKSPACE>,
                <&macro_release>,
                <&kp LALT>;

            label = "VIM_CB";
        };

        vim_cw: vim_cw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp DELETE>,
                <&macro_release>,
                <&kp LALT>;

            label = "VIM_CW";
        };

        vim_cc: vim_cc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp END>,
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp HOME>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp DELETE>;

            label = "VIM_CC";
        };
    };

    combos {
        compatible = "zmk,combos";

        // both right thumb keys
        // internal-left & external-right thumb keys
        // both left thumb keys
        // left index & middle fingers (home-row)
        // hold control & space for Adobe workflow

        combo_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <16 17>;
        };

        TG4_on {
            bindings = <&tog 4>;
            key-positions = <32 33>;
            layers = <0>;
        };

        TG4_off {
            bindings = <&tog 4>;
            key-positions = <32 33>;
            layers = <4>;
        };

        vim_cw {
            bindings = <&vim_cw>;
            key-positions = <22 1>;
            timeout-ms = <1000>;
            layers = <3>;
        };

        vim_cb {
            bindings = <&vim_cb>;
            key-positions = <22 24>;
            timeout-ms = <1000>;
            layers = <3>;
        };

        mo_system {
            bindings = <&mo 5>;
            key-positions = <19 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Base alpha layer

        default_layer {
            label = "Base";
            bindings = <
  &kp Q        &kp W  &kp E  &kp R               &kp T             &kp Y      &kp U        &kp I           &kp O         &kp P
  &mt LSHFT A  &kp S  &kp D  &kp F               &kp G             &kp H      &kp J        &kp K           &kp L         &mt RSHFT SEMICOLON
  &mt LCTRL Z  &kp X  &kp C  &kp V               &kp B             &kp N      &kp M        &mt LCMD COMMA  &mt RALT DOT  &mt RCTRL SLASH
                             &mt LALT BACKSPACE  &mt LCMD SPACE    &lt 2 F18  &lt 3 ENTER
            >;
        };

        // Windows override layer. Only remaps the COMMA mod-tap to RCMD
        // (macOS default on Base is LCMD). Sits directly above Base so the
        // higher layers (number/move/pointing/...) still take precedence at
        // this position. Activated automatically by src/profile_layer_sync.c
        // whenever BT profile 1 (Windows host) is active - keep this layer at
        // index 1 or update WINDOWS_LAYER_INDEX there.
        windows {
            label = "win";
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans          &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans          &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &mt RCMD COMMA  &trans  &trans
                          &trans  &trans    &trans  &trans
            >;
        };

        number {
            bindings = <
  &kp N1  &kp N2     &kp N3  &kp N4  &kp N5    &kp N6     &kp N7     &kp N8    &kp N9    &kp N0
  &trans  &kp GRAVE  &trans  &trans  &trans    &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp APOS
  &trans  &trans     &trans  &trans  &trans    &kp BSLH   &trans     &trans    &trans    &trans
                             &trans  &trans    &trans     &trans
            >;

            label = "number";
        };

        move {
            bindings = <
  &trans  &trans      &trans       &trans  &trans    &L_w      &D_x4          &U_x4         &R_w       &trans
  &trans  &kp TAB     &trans       &trans  &trans    &kp LEFT  &kp DOWN       &kp UP_ARROW  &kp RIGHT  &trans
  &trans  &kp DELETE  &tap_vim_cc  &trans  &trans    &kp HOME  &kp PAGE_DOWN  &kp PG_UP     &kp END    &trans
                                   &trans  &trans    &trans    &trans
            >;

            label = "move";
        };

        pointing {
            bindings = <
  &none      &none           &mmv MOVE_UP    &none            &none     &kp C_BRI_DN    &kp C_BRI_UP     &kp C_MUTE       &kp C_VOL_DN     &kp C_VOL_UP
  &kp LSHFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none     &msc SCRL_RIGHT &msc VSCRL_UP    &msc VSCRL_DOWN  &msc SCRL_LEFT   &kp RSHFT
  &none      &none           &trans          &trans           &none     &kp HOME        &kp PAGE_DOWN    &kp PG_UP        &kp END          &mkp MB3
                                             &mo 6            &trans    &mkp MB1        &mkp MB2
            >;

            label = "pointing";
        };

        system {
            bindings = <
  &kp F1      &kp F2        &kp F3        &kp F4        &kp F5         &kp F6  &kp F7  &kp F8  &kp F9   &kp F10
  &bt BT_NXT  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR     &trans  &trans  &trans  &kp F11  &kp F12
  &sys_reset  &trans        &trans        &trans        &bootloader    &trans  &trans  &trans  &trans   &trans
                                          &trans        &trans         &trans  &trans
            >;

            label = "system";
        };

        // Layer 6. Held from the pointing layer's left BACKSPACE thumb (position 30).
        // Every key is transparent on purpose: this layer exists only so the
        // mmv/msc input listeners can detect it and halve the movement speed.
        pointing_precision {
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                          &trans  &trans    &trans  &trans
            >;

            label = "precision";
        };

        // Main modifiers and arrow keys
        // Function keys with modifiers
        // Low frequency symbols.
        // Used to type regional accents.
        // Used to change the keyboard's settings.move {};
    };
};
